generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

generator security {
  provider = "node scripts/security-generator.js"
  output   = "../src/security/generated/classifications.ts"
}

datasource db {
  provider = "postgresql"
}

enum ToolLevel {
  BASIC
  DOF
  CERTIFIED
  MAY_CERTIFY_OTHERS
}

enum MembershipType {
  HOUSEHOLD
  VOLUNTEER
  CORPORATE
}

enum RSVPStatus {
  ATTENDING
  NOT_ATTENDING
  NO_RESPONSE
  MAYBE
}

enum AuditAction {
  CREATE
  EDIT
  DELETE
  BECOME_ADMIN
}

enum ProgramPhase {
  PLANNING
  UPCOMING
  RUNNING
  FINISHED
}

enum EnrollmentStatus {
  OPEN
  CLOSED
}

enum ProgramParticipantStatus {
  PENDING
  ACTIVE
}

model Participant {
  /// @sensitivity:pii
  id            Int       @id @default(autoincrement())
  /// @sensitivity:pii
  googleId      String?   @unique
  /// @sensitivity:pii
  email         String?   @unique
  /// @sensitivity:pii
  phone         String?
  /// @sensitivity:pii
  name          String?
  /// @sensitivity:internal
  emailVerified DateTime?
  /// @sensitivity:personal
  image         String?
  accounts      Account[]
  sessions      Session[]

  /// @sensitivity:pii
  dob                 DateTime?
  /// @sensitivity:pii
  homeAddress         String?
  /// @sensitivity:internal
  lastWaiverSign      DateTime?
  /// @sensitivity:internal
  waiverSignedBy      Int?
  /// @sensitivity:internal
  lastBackgroundCheck DateTime?
  /// @sensitivity:internal
  notificationSettings Json?

  /// @sensitivity:personal
  householdId Int?
  household   Household? @relation(fields: [householdId], references: [id])

  /// @sensitivity:internal
  sysadmin    Boolean @default(false)
  /// @sensitivity:public
  boardMember Boolean @default(false)
  /// @sensitivity:internal
  keyholder   Boolean @default(false)
  /// @sensitivity:internal
  shopSteward Boolean @default(false)

  toolStatuses        ToolStatus[]
  householdLeads      HouseholdLead[]
  memberships         Membership[]         @relation("ParticipantMemberships")
  corporationLeads    CorporationLead[]
  corporationMembers  CorporationMember[]
  programVolunteers   ProgramVolunteer[]
  programParticipants ProgramParticipant[]
  programsLed         Program[]            @relation("ProgramLeadMentor")
  feePayments         FeePayment[]
  rsvps               RSVP[]
  rawBadgeEvents      RawBadgeEvent[]
  visits              Visit[]
  eventsConfirmedBy   Event[]              @relation("EventAttendanceConfirmer")
}

model Tool {
  /// @sensitivity:internal
  id           Int          @id @default(autoincrement())
  /// @sensitivity:internal
  name         String
  /// @sensitivity:internal
  safetyGuide  String?
  toolStatuses ToolStatus[]
}

model ToolStatus {
  /// @sensitivity:pii
  userId Int
  /// @sensitivity:internal
  toolId Int
  /// @sensitivity:internal
  level  ToolLevel

  user Participant @relation(fields: [userId], references: [id])
  tool Tool        @relation(fields: [toolId], references: [id])

  @@id([userId, toolId])
}

model Household {
  /// @sensitivity:personal
  id      Int     @id @default(autoincrement())
  /// @sensitivity:pii
  name    String?
  /// @sensitivity:pii
  address String?
  /// @sensitivity:pii
  emergencyContactName  String?
  /// @sensitivity:pii
  emergencyContactPhone String?

  participants Participant[]
  leads        HouseholdLead[]
  memberships  Membership[]
}

model HouseholdLead {
  /// @sensitivity:personal
  householdId   Int
  /// @sensitivity:pii
  participantId Int

  household   Household   @relation(fields: [householdId], references: [id])
  participant Participant @relation(fields: [participantId], references: [id])

  @@id([householdId, participantId])
}

model Membership {
  /// @sensitivity:internal
  id                   Int            @id @default(autoincrement())
  /// @sensitivity:internal
  since                DateTime       @default(now())
  /// @sensitivity:internal
  type                 MembershipType
  /// @sensitivity:internal
  active               Boolean        @default(true)
  /// @sensitivity:internal
  latestShopifyReceipt String?
  /// @sensitivity:internal
  latestDocusign       String?

  /// @sensitivity:personal
  householdId Int?
  household   Household? @relation(fields: [householdId], references: [id])

  /// @sensitivity:pii
  volunteerId Int?
  volunteer   Participant? @relation("ParticipantMemberships", fields: [volunteerId], references: [id])

  /// @sensitivity:public
  corporateId Int?
  corporate   Corporation? @relation(fields: [corporateId], references: [id])
}

model Corporation {
  /// @sensitivity:public
  id           Int     @id @default(autoincrement())
  /// @sensitivity:internal
  primaryEmail String?
  /// @sensitivity:internal
  address      String?

  leads       CorporationLead[]
  members     CorporationMember[]
  memberships Membership[]
}

model CorporationLead {
  /// @sensitivity:public
  corporationId Int
  /// @sensitivity:pii
  participantId Int

  corporation Corporation @relation(fields: [corporationId], references: [id])
  participant Participant @relation(fields: [participantId], references: [id])

  @@id([corporationId, participantId])
}

model CorporationMember {
  /// @sensitivity:public
  corporationId Int
  /// @sensitivity:pii
  participantId Int

  corporation Corporation @relation(fields: [corporationId], references: [id])
  participant Participant @relation(fields: [participantId], references: [id])

  @@id([corporationId, participantId])
}

model Program {
  /// @sensitivity:public
  id           Int       @id @default(autoincrement())
  /// @sensitivity:public
  name            String
  /// @sensitivity:pii
  leadMentorId    Int?
  leadMentor      Participant? @relation("ProgramLeadMentor", fields: [leadMentorId], references: [id])
  /// @sensitivity:public
  begin           DateTime?
  /// @sensitivity:public
  end             DateTime?
  /// @sensitivity:public
  phase                        ProgramPhase @default(PLANNING)
  /// @sensitivity:public
  enrollmentStatus             EnrollmentStatus @default(CLOSED)
  /// @sensitivity:public
  memberOnly                   Boolean   @default(false)
  /// @sensitivity:public
  minAge                       Int?
  /// @sensitivity:public
  maxAge                       Int?
  /// @sensitivity:public
  maxParticipants              Int?
  /// @sensitivity:personal
  leadMentorNotificationSettings Json?

  /// @sensitivity:public
  memberPrice       Int?
  /// @sensitivity:public
  nonMemberPrice    Int?
  /// @sensitivity:public
  shopifyProductId  String?
  /// @sensitivity:public
  shopifyMemberVariantId String?
  /// @sensitivity:public
  shopifyNonMemberVariantId String?

  volunteers   ProgramVolunteer[]
  participants ProgramParticipant[]
  fees         Fee[]
  events       Event[]
}

model ProgramVolunteer {
  /// @sensitivity:public
  programId     Int
  /// @sensitivity:pii
  participantId Int
  /// @sensitivity:internal
  isCore        Boolean @default(false)

  program     Program     @relation(fields: [programId], references: [id])
  participant Participant @relation(fields: [participantId], references: [id])

  @@id([programId, participantId])
}

model ProgramParticipant {
  /// @sensitivity:public
  programId     Int
  /// @sensitivity:pii
  participantId Int
  /// @sensitivity:internal
  status        ProgramParticipantStatus @default(PENDING)
  /// @sensitivity:personal
  paymentPlanRequested Boolean @default(false)
  /// @sensitivity:internal
  pendingSince         DateTime? @default(now())

  program     Program     @relation(fields: [programId], references: [id])
  participant Participant @relation(fields: [participantId], references: [id])

  @@id([programId, participantId])
}

model Fee {
  /// @sensitivity:public
  id             Int    @id @default(autoincrement())
  /// @sensitivity:public
  programId      Int
  /// @sensitivity:public
  name           String
  /// @sensitivity:public
  nonMemberPrice Int
  /// @sensitivity:public
  memberPrice    Int

  program  Program      @relation(fields: [programId], references: [id])
  payments FeePayment[]
}

model FeePayment {
  /// @sensitivity:public
  feeId             Int
  /// @sensitivity:pii
  participantId     Int
  /// @sensitivity:internal
  paidOn            DateTime? @default(now())
  /// @sensitivity:internal
  shopifyLink       String?
  /// @sensitivity:internal
  quickBooksInvoice String?
  /// @sensitivity:internal
  customNote        String?

  fee         Fee         @relation(fields: [feeId], references: [id])
  participant Participant @relation(fields: [participantId], references: [id])

  @@id([feeId, participantId])
}

model Event {
  /// @sensitivity:public
  id          Int      @id @default(autoincrement())
  /// @sensitivity:public
  programId   Int?
  /// @sensitivity:public
  name        String
  /// @sensitivity:public
  start       DateTime
  /// @sensitivity:public
  end         DateTime
  /// @sensitivity:public
  description String?

  /// @sensitivity:internal
  attendanceConfirmedAt DateTime?
  /// @sensitivity:internal
  attendanceConfirmedById Int?
  attendanceConfirmedBy Participant? @relation("EventAttendanceConfirmer", fields: [attendanceConfirmedById], references: [id])
  /// @sensitivity:internal
  postEventEmailSent    Boolean      @default(false)
  /// @sensitivity:public
  recurringGroupId      String?

  program Program? @relation(fields: [programId], references: [id])
  rsvps   RSVP[]
  visits  Visit[]
}

model RSVP {
  /// @sensitivity:public
  eventId       Int
  /// @sensitivity:pii
  participantId Int
  /// @sensitivity:personal
  status        RSVPStatus

  event       Event       @relation(fields: [eventId], references: [id])
  participant Participant @relation(fields: [participantId], references: [id])

  @@id([eventId, participantId])
}

model RawBadgeEvent {
  /// @sensitivity:internal
  id            Int      @id @default(autoincrement())
  /// @sensitivity:pii
  participantId Int
  /// @sensitivity:internal
  time          DateTime @default(now())
  /// @sensitivity:internal
  location      String?

  participant Participant @relation(fields: [participantId], references: [id])

  @@index([participantId, time])  // Double-badge detection in /api/scan
}

model Visit {
  /// @sensitivity:personal
  id                Int       @id @default(autoincrement())
  /// @sensitivity:pii
  participantId     Int
  /// @sensitivity:internal
  arrived           DateTime
  /// @sensitivity:internal
  departed          DateTime?
  /// @sensitivity:public
  associatedEventId Int?

  participant Participant @relation(fields: [participantId], references: [id])
  event       Event?      @relation(fields: [associatedEventId], references: [id])

  @@index([participantId, departed])  // Active visits lookup in /api/scan
}

model AuditLog {
  /// @sensitivity:internal
  id                      Int         @id @default(autoincrement())
  /// @sensitivity:internal
  time                    DateTime    @default(now())
  /// @sensitivity:internal
  actorId                 Int
  /// @sensitivity:internal
  action                  AuditAction
  /// @sensitivity:internal
  tableName               String
  /// @sensitivity:internal
  affectedEntityId        Int
  /// @sensitivity:internal
  secondaryAffectedEntity Int?
  /// @sensitivity:internal
  oldData                 Json?
  /// @sensitivity:internal
  newData                 Json?
}

model Account {
  /// @sensitivity:internal
  id                String  @id @default(cuid())
  /// @sensitivity:internal
  userId            Int     @map("participant_id")
  /// @sensitivity:internal
  type              String
  /// @sensitivity:internal
  provider          String
  /// @sensitivity:internal
  providerAccountId String
  /// @sensitivity:secret
  refresh_token     String? @db.Text
  /// @sensitivity:secret
  access_token      String? @db.Text
  /// @sensitivity:internal
  expires_at        Int?
  /// @sensitivity:internal
  token_type        String?
  /// @sensitivity:internal
  scope             String?
  /// @sensitivity:secret
  id_token          String? @db.Text
  /// @sensitivity:internal
  session_state     String?

  user Participant @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  /// @sensitivity:internal
  id           String      @id @default(cuid())
  /// @sensitivity:secret
  sessionToken String      @unique
  /// @sensitivity:internal
  userId       Int         @map("participant_id")
  /// @sensitivity:internal
  expires      DateTime
  user         Participant @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  /// @sensitivity:internal
  identifier String
  /// @sensitivity:secret
  token      String   @unique
  /// @sensitivity:internal
  expires    DateTime

  @@unique([identifier, token])
}

model ErrorLog {
  /// @sensitivity:internal
  id        Int      @id @default(autoincrement())
  /// @sensitivity:internal
  createdAt DateTime @default(now())
  /// @sensitivity:internal
  route     String?
  /// @sensitivity:internal
  message   String
  /// @sensitivity:internal
  stack     String?
  /// @sensitivity:internal
  context   Json?
}

model SystemMetric {
  /// @sensitivity:internal
  id        Int      @id @default(autoincrement())
  /// @sensitivity:internal
  timestamp DateTime @default(now())
  /// @sensitivity:internal
  metric    String
  /// @sensitivity:internal
  value     Float
}
