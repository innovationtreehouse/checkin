generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

generator security {
  provider = "node scripts/security-generator.js"
  output   = "../src/security/generated/classifications.ts"
}

datasource db {
  provider = "postgresql"
}

enum ToolLevel {
  BASIC
  DOF
  CERTIFIED
  MAY_CERTIFY_OTHERS
}

enum MembershipType {
  HOUSEHOLD
  VOLUNTEER
  CORPORATE
}

enum RSVPStatus {
  ATTENDING
  NOT_ATTENDING
  NO_RESPONSE
  MAYBE
}

enum AuditAction {
  CREATE
  EDIT
  DELETE
  BECOME_ADMIN
}

enum ProgramPhase {
  PLANNING
  UPCOMING
  RUNNING
  FINISHED
}

enum EnrollmentStatus {
  OPEN
  CLOSED
}

enum ProgramParticipantStatus {
  PENDING
  ACTIVE
}

model Participant {
  /// @sensitivity:public
  id            Int       @id @default(autoincrement())
  /// @sensitivity:pii
  googleId      String?   @unique
  /// @sensitivity:pii
  email         String?   @unique
  /// @sensitivity:pii
  phone         String?
  /// @sensitivity:public
  name          String?
  /// @sensitivity:internal
  emailVerified DateTime?
  /// @sensitivity:public
  image         String?
  accounts      Account[]
  sessions      Session[]

  /// @sensitivity:pii
  dob                  DateTime?
  /// @sensitivity:internal
  lastWaiverSign       DateTime?
  /// @sensitivity:internal
  waiverSignedBy       Int?
  /// @sensitivity:internal
  lastBackgroundCheck  DateTime?
  /// @sensitivity:personal
  notificationSettings Json?

  /// @sensitivity:public
  householdId Int
  household   Household @relation(fields: [householdId], references: [id])

  /// @sensitivity:public
  role      ParticipantRole @default(PARENT)
  /// @sensitivity:personal
  allergies String?

  /// @sensitivity:internal
  sysadmin                Boolean @default(false)
  /// @sensitivity:public
  boardMember             Boolean @default(false)
  /// @sensitivity:internal
  keyholder               Boolean @default(false)
  /// @sensitivity:internal
  shopSteward             Boolean @default(false)
  /// @sensitivity:internal
  backgroundCheckReviewer Boolean @default(false)

  toolStatuses        ToolStatus[]
  bgAttestations      MembershipAttestation[] @relation("BgAttestations")
  householdLeads      HouseholdLead[]
  memberships         Membership[]            @relation("ParticipantMemberships")
  corporationLeads    CorporationLead[]
  corporationMembers  CorporationMember[]
  programVolunteers   ProgramVolunteer[]
  programParticipants ProgramParticipant[]
  programsLed         Program[]               @relation("ProgramLeadMentor")
  feePayments         FeePayment[]
  rsvps               RSVP[]
  rawBadgeEvents      RawBadgeEvent[]
  visits              Visit[]
  eventsConfirmedBy   Event[]                 @relation("EventAttendanceConfirmer")
}

model Tool {
  /// @sensitivity:public
  id           Int          @id @default(autoincrement())
  /// @sensitivity:public
  name         String
  /// @sensitivity:public
  safetyGuide  String?
  toolStatuses ToolStatus[]
}

model ToolStatus {
  /// @sensitivity:public
  userId Int
  /// @sensitivity:public
  toolId Int
  /// @sensitivity:internal
  level  ToolLevel

  user Participant @relation(fields: [userId], references: [id])
  tool Tool        @relation(fields: [toolId], references: [id])

  @@id([userId, toolId])
}

model Household {
  /// @sensitivity:public
  id                    Int     @id @default(autoincrement())
  /// @sensitivity:public
  name                  String?
  /// @sensitivity:personal
  address               String?
  /// @sensitivity:personal
  emergencyContactName  String?
  /// @sensitivity:personal
  emergencyContactPhone String?

  participants Participant[]
  leads        HouseholdLead[]
  memberships  Membership[]
}

model HouseholdLead {
  /// @sensitivity:public
  householdId   Int
  /// @sensitivity:public
  participantId Int

  household   Household   @relation(fields: [householdId], references: [id])
  participant Participant @relation(fields: [participantId], references: [id])

  @@id([householdId, participantId])
}

enum MembershipStatus {
  NONE
  ACTIVE
  REVOKED
}

enum MembershipProcessKind {
  INITIAL
  RENEWAL
}

enum MembershipProcessStatus {
  INTAKE
  EXTERNAL
  BG_REVIEW
  PENDING_PAYMENT
  ACTIVE
  BLOCKED
  PENDING_RENEWAL
  RENEWAL_PENDING_BG
}

enum ParticipantRole {
  PARENT
  CHILD
}

enum AttestationResult {
  APPROVE
  REJECT
}

model Membership {
  /// @sensitivity:public
  id                   Int            @id @default(autoincrement())
  /// @sensitivity:public
  since                DateTime       @default(now())
  /// @sensitivity:public
  type                 MembershipType
  /// @sensitivity:public
  active               Boolean        @default(true)
  /// @sensitivity:personal
  latestShopifyReceipt String?
  /// @sensitivity:personal
  latestDocusign       String?

  /// @sensitivity:public
  householdId Int?
  household   Household? @relation(fields: [householdId], references: [id])

  /// @sensitivity:public
  volunteerId Int?
  volunteer   Participant? @relation("ParticipantMemberships", fields: [volunteerId], references: [id])

  /// @sensitivity:public
  corporateId Int?
  corporate   Corporation? @relation(fields: [corporateId], references: [id])

  processes MembershipProcess[]
}

model MembershipProcess {
  /// @sensitivity:public
  id                    Int                     @id @default(autoincrement())
  /// @sensitivity:public
  membershipId          Int
  membership            Membership              @relation(fields: [membershipId], references: [id])
  /// @sensitivity:public
  kind                  MembershipProcessKind
  /// @sensitivity:internal
  status                MembershipProcessStatus
  /// @sensitivity:internal
  stageEnteredAt        DateTime?               @default(now())
  /// @sensitivity:public
  createdAt             DateTime                @default(now())
  /// @sensitivity:internal
  zohoEnvelopeId        String?
  /// @sensitivity:internal
  contractSignedAt      DateTime?
  /// @sensitivity:internal
  bgConsentAt           DateTime?
  /// @sensitivity:internal
  shopifyDraftOrderId   String?
  /// @sensitivity:personal
  shopifyInvoiceUrl     String?
  /// @sensitivity:internal
  shopifyOrderId        String?
  /// @sensitivity:internal
  paidAt                DateTime?
  /// @sensitivity:internal
  certifiedById         Int?
  /// @sensitivity:internal
  renewalReminderSentAt DateTime?

  attestations MembershipAttestation[]

  @@index([membershipId])
  @@index([status])
}

model MembershipAttestation {
  /// @sensitivity:public
  id              Int               @id @default(autoincrement())
  /// @sensitivity:public
  processId       Int
  process         MembershipProcess @relation(fields: [processId], references: [id])
  /// @sensitivity:public
  reviewerId      Int
  reviewer        Participant       @relation("BgAttestations", fields: [reviewerId], references: [id])
  /// @sensitivity:internal
  result          AttestationResult
  /// @sensitivity:internal
  markedVolunteer Boolean           @default(false)
  /// @sensitivity:public
  createdAt       DateTime          @default(now())

  @@unique([processId, reviewerId])
}

model VolunteerDesignation {
  /// @sensitivity:public
  id          Int      @id @default(autoincrement())
  /// @sensitivity:pii
  email       String   @unique
  /// @sensitivity:internal
  createdById Int?
  /// @sensitivity:public
  createdAt   DateTime @default(now())
}

model BoardSettings {
  /// @sensitivity:public
  id                         Int       @id @default(1)
  /// @sensitivity:public
  normalDuesCents            Int       @default(0)
  /// @sensitivity:public
  volunteerDuesCents         Int       @default(0)
  /// @sensitivity:public
  membershipYearBoundary     DateTime?
  /// @sensitivity:internal
  shopifyMembershipProductId String?
  /// @sensitivity:internal
  shopifyNormalVariantId     String?
  /// @sensitivity:internal
  shopifyVolunteerVariantId  String?
  /// @sensitivity:internal
  shopifyPriceSyncedAt       DateTime?
  /// @sensitivity:internal
  averityDeepLinkUrl         String?
  /// @sensitivity:internal
  updatedAt                  DateTime  @updatedAt
}

model Corporation {
  /// @sensitivity:public
  id           Int     @id @default(autoincrement())
  /// @sensitivity:pii
  primaryEmail String?
  /// @sensitivity:personal
  address      String?

  leads       CorporationLead[]
  members     CorporationMember[]
  memberships Membership[]
}

model CorporationLead {
  /// @sensitivity:public
  corporationId Int
  /// @sensitivity:public
  participantId Int

  corporation Corporation @relation(fields: [corporationId], references: [id])
  participant Participant @relation(fields: [participantId], references: [id])

  @@id([corporationId, participantId])
}

model CorporationMember {
  /// @sensitivity:public
  corporationId Int
  /// @sensitivity:public
  participantId Int

  corporation Corporation @relation(fields: [corporationId], references: [id])
  participant Participant @relation(fields: [participantId], references: [id])

  @@id([corporationId, participantId])
}

model Program {
  /// @sensitivity:public
  id                             Int              @id @default(autoincrement())
  /// @sensitivity:public
  name                           String
  /// @sensitivity:public
  leadMentorId                   Int?
  leadMentor                     Participant?     @relation("ProgramLeadMentor", fields: [leadMentorId], references: [id])
  /// @sensitivity:public
  begin                          DateTime?
  /// @sensitivity:public
  end                            DateTime?
  /// @sensitivity:public
  phase                          ProgramPhase     @default(PLANNING)
  /// @sensitivity:public
  enrollmentStatus               EnrollmentStatus @default(CLOSED)
  /// @sensitivity:public
  memberOnly                     Boolean          @default(false)
  /// @sensitivity:public
  minAge                         Int?
  /// @sensitivity:public
  maxAge                         Int?
  /// @sensitivity:public
  maxParticipants                Int?
  /// @sensitivity:personal
  leadMentorNotificationSettings Json?

  /// @sensitivity:public
  memberPrice               Int?
  /// @sensitivity:public
  nonMemberPrice            Int?
  /// @sensitivity:public
  shopifyProductId          String?
  /// @sensitivity:public
  shopifyMemberVariantId    String?
  /// @sensitivity:public
  shopifyNonMemberVariantId String?

  volunteers   ProgramVolunteer[]
  participants ProgramParticipant[]
  fees         Fee[]
  events       Event[]
}

model ProgramVolunteer {
  /// @sensitivity:public
  programId     Int
  /// @sensitivity:public
  participantId Int
  /// @sensitivity:internal
  isCore        Boolean @default(false)

  program     Program     @relation(fields: [programId], references: [id])
  participant Participant @relation(fields: [participantId], references: [id])

  @@id([programId, participantId])
}

model ProgramParticipant {
  /// @sensitivity:public
  programId            Int
  /// @sensitivity:public
  participantId        Int
  /// @sensitivity:public
  status               ProgramParticipantStatus @default(PENDING)
  /// @sensitivity:personal
  paymentPlanRequested Boolean                  @default(false)
  /// @sensitivity:internal
  pendingSince         DateTime?                @default(now())

  program     Program     @relation(fields: [programId], references: [id])
  participant Participant @relation(fields: [participantId], references: [id])

  @@id([programId, participantId])
}

model Fee {
  /// @sensitivity:public
  id             Int    @id @default(autoincrement())
  /// @sensitivity:public
  programId      Int
  /// @sensitivity:public
  name           String
  /// @sensitivity:public
  nonMemberPrice Int
  /// @sensitivity:public
  memberPrice    Int

  program  Program      @relation(fields: [programId], references: [id])
  payments FeePayment[]
}

model FeePayment {
  /// @sensitivity:public
  feeId             Int
  /// @sensitivity:public
  participantId     Int
  /// @sensitivity:personal
  paidOn            DateTime? @default(now())
  /// @sensitivity:personal
  shopifyLink       String?
  /// @sensitivity:personal
  quickBooksInvoice String?
  /// @sensitivity:personal
  customNote        String?

  fee         Fee         @relation(fields: [feeId], references: [id])
  participant Participant @relation(fields: [participantId], references: [id])

  @@id([feeId, participantId])
}

model Event {
  /// @sensitivity:public
  id          Int      @id @default(autoincrement())
  /// @sensitivity:public
  programId   Int?
  /// @sensitivity:public
  name        String
  /// @sensitivity:public
  start       DateTime
  /// @sensitivity:public
  end         DateTime
  /// @sensitivity:public
  description String?

  /// @sensitivity:internal
  attendanceConfirmedAt   DateTime?
  /// @sensitivity:internal
  attendanceConfirmedById Int?
  attendanceConfirmedBy   Participant? @relation("EventAttendanceConfirmer", fields: [attendanceConfirmedById], references: [id])
  /// @sensitivity:internal
  postEventEmailSent      Boolean      @default(false)
  /// @sensitivity:public
  recurringGroupId        String?

  program Program? @relation(fields: [programId], references: [id])
  rsvps   RSVP[]
  visits  Visit[]
}

model RSVP {
  /// @sensitivity:public
  eventId       Int
  /// @sensitivity:public
  participantId Int
  /// @sensitivity:public
  status        RSVPStatus

  event       Event       @relation(fields: [eventId], references: [id])
  participant Participant @relation(fields: [participantId], references: [id])

  @@id([eventId, participantId])
}

model RawBadgeEvent {
  /// @sensitivity:internal
  id            Int      @id @default(autoincrement())
  /// @sensitivity:internal
  participantId Int
  /// @sensitivity:personal
  time          DateTime @default(now())
  /// @sensitivity:personal
  location      String?

  participant Participant @relation(fields: [participantId], references: [id])

  @@index([participantId, time]) // Double-badge detection in /api/scan
}

model Visit {
  /// @sensitivity:public
  id                Int       @id @default(autoincrement())
  /// @sensitivity:public
  participantId     Int
  /// @sensitivity:personal
  arrived           DateTime
  /// @sensitivity:personal
  departed          DateTime?
  /// @sensitivity:public
  associatedEventId Int?

  participant Participant @relation(fields: [participantId], references: [id])
  event       Event?      @relation(fields: [associatedEventId], references: [id])

  @@index([participantId, departed]) // Active visits lookup in /api/scan
}

model AuditLog {
  /// @sensitivity:internal
  id                      Int         @id @default(autoincrement())
  /// @sensitivity:internal
  time                    DateTime    @default(now())
  /// @sensitivity:internal
  actorId                 Int
  /// @sensitivity:internal
  action                  AuditAction
  /// @sensitivity:internal
  tableName               String
  /// @sensitivity:internal
  affectedEntityId        Int
  /// @sensitivity:internal
  secondaryAffectedEntity Int?
  /// @sensitivity:internal
  oldData                 Json?
  /// @sensitivity:internal
  newData                 Json?
}

model Account {
  /// @sensitivity:internal
  id                String  @id @default(cuid())
  /// @sensitivity:internal
  userId            Int     @map("participant_id")
  /// @sensitivity:internal
  type              String
  /// @sensitivity:internal
  provider          String
  /// @sensitivity:internal
  providerAccountId String
  /// @sensitivity:secret
  refresh_token     String? @db.Text
  /// @sensitivity:secret
  access_token      String? @db.Text
  /// @sensitivity:internal
  expires_at        Int?
  /// @sensitivity:internal
  token_type        String?
  /// @sensitivity:internal
  scope             String?
  /// @sensitivity:secret
  id_token          String? @db.Text
  /// @sensitivity:internal
  session_state     String?

  user Participant @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  /// @sensitivity:internal
  id           String      @id @default(cuid())
  /// @sensitivity:secret
  sessionToken String      @unique
  /// @sensitivity:internal
  userId       Int         @map("participant_id")
  /// @sensitivity:internal
  expires      DateTime
  user         Participant @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  /// @sensitivity:internal
  identifier String
  /// @sensitivity:secret
  token      String   @unique
  /// @sensitivity:internal
  expires    DateTime

  @@unique([identifier, token])
}

model ErrorLog {
  /// @sensitivity:internal
  id        Int      @id @default(autoincrement())
  /// @sensitivity:internal
  createdAt DateTime @default(now())
  /// @sensitivity:internal
  route     String?
  /// @sensitivity:internal
  message   String
  /// @sensitivity:internal
  stack     String?
  /// @sensitivity:internal
  context   Json?
}

model SystemMetric {
  /// @sensitivity:internal
  id        Int      @id @default(autoincrement())
  /// @sensitivity:internal
  timestamp DateTime @default(now())
  /// @sensitivity:internal
  metric    String
  /// @sensitivity:internal
  value     Float
}
