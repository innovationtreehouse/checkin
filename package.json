{
  "name": "checkmein",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4000 -H 0.0.0.0",
    "build": "next build",
    "start": "next start -p 4000",
    "lint": "eslint --max-warnings 0",
    "test": "jest --runInBand --forceExit",
    "test:ci": "jest --ci --runInBand --forceExit",
    "test:integration": "jest --ci --runInBand --forceExit --testPathIgnorePatterns=/node_modules/ --testRegex \"\\.integration\\.test\\.[jt]sx?$\"",
    "check-route-coverage": "ts-node --project scripts/tsconfig.json scripts/check-route-coverage.ts",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@mantine/core": "^7.17.8",
    "@mantine/form": "^7.17.8",
    "@mantine/hooks": "^7.17.8",
    "@mantine/modals": "^7.17.8",
    "@mantine/notifications": "^7.17.8",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@react-pdf/renderer": "^4.3.2",
    "@tabler/icons-react": "^3.44.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "next": "^16.1.6",
    "next-auth": "^4.24.13",
    "pg": "^8.18.0",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-qr-code": "^2.0.18",
    "resend": "^6.9.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@prisma/generator-helper": "7.8.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^22",
    "@types/pg": "^8.16.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supertest": "^7.2.0",
    "cross-fetch": "^4.1.0",
    "dotenv": "^17.3.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.2.0",
    "lint-staged": "^16.3.2",
    "node-mocks-http": "^1.17.2",
    "prisma": "7.8.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-morph": "^25.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ]
  }
}
