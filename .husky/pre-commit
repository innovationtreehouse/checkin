echo "Regenerating security classifications from schema..."
npx prisma generate || {
  echo "Prisma generate failed (likely missing /// @sensitivity annotation). Commit blocked."
  exit 1
}
if ! git diff --exit-code src/security/generated/ >/dev/null 2>&1; then
  echo "src/security/generated/ is out of date. Run 'npx prisma generate' and stage the result."
  exit 1
fi

echo "Running tests..."
npm run test:ci || {
  echo "Tests failed! Commit bypassed."
  exit 1
}

echo "Running linter and typescript checks..."
npx lint-staged
npx tsc --noEmit
